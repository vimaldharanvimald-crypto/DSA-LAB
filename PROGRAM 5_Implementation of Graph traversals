#include <stdio.h> 
#include <stdlib.h> 
 
#define MAX 100 
 
int adj[MAX][MAX]; 
int visited[MAX]; 
int queue[MAX]; 
int front = -1, rear = -1; 
int n; 
 
void enqueue(int v) { 
    if (rear == MAX - 1) 
        printf("\nQueue Overflow\n"); 
    else { 
        if (front == -1) 
            front = 0; 
        rear = rear + 1; 
        queue[rear] = v; 
    } 
}  
int dequeue() { 
    int item; 
    if (front == -1 || front > rear) { 
        printf("\nQueue Underflow\n"); 
        exit(1); 
    } else { 
        item = queue[front]; 
        front = front + 1; 
    } 
    return item; 
} 
 
int isQueueEmpty() { 
    return (front == -1 || front > rear); 
} 
 
void BFS(int startVertex) { 
    int v; 
    enqueue(startVertex); 
    visited[startVertex] = 1; 
 
    while (!isQueueEmpty()) { 
        v = dequeue(); 
        printf("%d ", v); 
 
        for (int i = 0; i < n; i++) { 
            if (adj[v][i] == 1 && !visited[i]) { 
                enqueue(i); 
                visited[i] = 1; 
            } 
        } 
    } 
} 
 
void DFS(int v) { 
    printf("%d ", v); 
    visited[v] = 1; 
 
    for (int i = 0; i < n; i++) { 
        if (adj[v][i] == 1 && !visited[i]) { 
            DFS(i); 
        } 
    } 
} 
 
void initialize() { 
    for (int i = 0; i < MAX; i++) { 
        visited[i] = 0; 
        for (int j = 0; j < MAX; j++) { 
            adj[i][j] = 0; 
      } 
    } 
} 
 
int main() { 
    int edges, origin, destination; 
     
    printf("Enter the number of vertices: "); 
    scanf("%d", &n); 
    printf("Enter the number of edges: "); 
    scanf("%d", &edges); 
 
    initialize(); 
 
    for (int i = 0; i < edges; i++) { 
        printf("Enter edge (origin destination): "); 
        scanf("%d %d", &origin, &destination); 
        adj[origin][destination] = 1; 
        adj[destination][origin] = 1; // For undirected graph 
    } 
 
    int startVertex; 
    printf("Enter the start vertex for BFS: "); 
    scanf("%d", &startVertex); 
 
    printf("BFS Traversal: "); 
    BFS(startVertex); 
    printf("\n"); 
 
    for (int i = 0; i < n; i++) { 
        visited[i] = 0; 
    } 
 
    printf("Enter the start vertex for DFS: "); 
    scanf("%d", &startVertex); 
 
    printf("DFS Traversal: "); 
    DFS(startVertex); 
    printf("\n"); 
 
    return 0; 
} 

